<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <TextView
            android:id="@+id/calculator_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="#00796B"
            android:padding="12dp"
            android:text="ConstraintLayoutTest"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="42dp"
            android:gravity="center_vertical"
            android:text="Input"
            android:textSize="20sp"
            app:layout_constraintTop_toBottomOf="@id/calculator_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/result"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="#E3E4BD"
            android:gravity="end|center_vertical"
            android:padding="10dp"
            android:text="0.0"
            android:textColor="#202018"
            android:textSize="22sp"
            app:layout_constraintTop_toBottomOf="@id/input"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 三条垂直辅助线将键盘等分为四列，按钮的宽度由两侧约束决定。 -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_25"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.25" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_50"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.50" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_75"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.75" />

        <Button
            android:id="@+id/key_7"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="4dp"
            android:layout_marginTop="24dp"
            android:padding="0dp"
            android:text="7"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guide_25"
            app:layout_constraintTop_toBottomOf="@id/result" />

        <Button
            android:id="@+id/key_8"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="4dp"
            android:layout_marginTop="24dp"
            android:padding="0dp"
            android:text="8"
            app:layout_constraintStart_toStartOf="@id/guide_25"
            app:layout_constraintEnd_toStartOf="@id/guide_50"
            app:layout_constraintTop_toBottomOf="@id/result" />

        <Button
            android:id="@+id/key_9"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="4dp"
            android:layout_marginTop="24dp"
            android:padding="0dp"
            android:text="9"
            app:layout_constraintStart_toStartOf="@id/guide_50"
            app:layout_constraintEnd_toStartOf="@id/guide_75"
            app:layout_constraintTop_toBottomOf="@id/result" />

        <Button
            android:id="@+id/key_div"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="4dp"
            android:layout_marginTop="24dp"
            android:padding="0dp"
            android:text="÷"
            app:layout_constraintStart_toStartOf="@id/guide_75"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/result" />

        <Button
            android:id="@+id/key_4"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="4dp"
            android:layout_marginTop="24dp"
            android:padding="0dp"
            android:text="4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guide_25"
            app:layout_constraintTop_toBottomOf="@id/key_7" />

        <Button
            android:id="@+id/key_5"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="4dp"
            android:layout_marginTop="24dp"
            android:padding="0dp"
            android:text="5"
            app:layout_constraintStart_toStartOf="@id/guide_25"
            app:layout_constraintEnd_toStartOf="@id/guide_50"
            app:layout_constraintTop_toBottomOf="@id/key_8" />

        <Button
            android:id="@+id/key_6"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="4dp"
            android:layout_marginTop="24dp"
            android:padding="0dp"
            android:text="6"
            app:layout_constraintStart_toStartOf="@id/guide_50"
            app:layout_constraintEnd_toStartOf="@id/guide_75"
            app:layout_constraintTop_toBottomOf="@id/key_9" />

        <Button
            android:id="@+id/key_mul"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="4dp"
            android:layout_marginTop="24dp"
            android:padding="0dp"
            android:text="×"
            app:layout_constraintStart_toStartOf="@id/guide_75"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/key_div" />

        <Button
            android:id="@+id/key_1"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="4dp"
            android:layout_marginTop="24dp"
            android:padding="0dp"
            android:text="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guide_25"
            app:layout_constraintTop_toBottomOf="@id/key_4" />

        <Button
            android:id="@+id/key_2"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="4dp"
            android:layout_marginTop="24dp"
            android:padding="0dp"
            android:text="2"
            app:layout_constraintStart_toStartOf="@id/guide_25"
            app:layout_constraintEnd_toStartOf="@id/guide_50"
            app:layout_constraintTop_toBottomOf="@id/key_5" />

        <Button
            android:id="@+id/key_3"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="4dp"
            android:layout_marginTop="24dp"
            android:padding="0dp"
            android:text="3"
            app:layout_constraintStart_toStartOf="@id/guide_50"
            app:layout_constraintEnd_toStartOf="@id/guide_75"
            app:layout_constraintTop_toBottomOf="@id/key_6" />

        <Button
            android:id="@+id/key_add"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="4dp"
            android:layout_marginTop="24dp"
            android:padding="0dp"
            android:text="+"
            app:layout_constraintStart_toStartOf="@id/guide_75"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/key_mul" />

        <Button
            android:id="@+id/key_dot"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="4dp"
            android:layout_marginTop="24dp"
            android:padding="0dp"
            android:text="."
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guide_25"
            app:layout_constraintTop_toBottomOf="@id/key_1" />

        <Button
            android:id="@+id/key_0"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="4dp"
            android:layout_marginTop="24dp"
            android:padding="0dp"
            android:text="0"
            app:layout_constraintStart_toStartOf="@id/guide_25"
            app:layout_constraintEnd_toStartOf="@id/guide_50"
            app:layout_constraintTop_toBottomOf="@id/key_2" />

        <Button
            android:id="@+id/key_equals"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="4dp"
            android:layout_marginTop="24dp"
            android:padding="0dp"
            android:text="="
            app:layout_constraintStart_toStartOf="@id/guide_50"
            app:layout_constraintEnd_toStartOf="@id/guide_75"
            app:layout_constraintTop_toBottomOf="@id/key_3" />

        <Button
            android:id="@+id/key_sub"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="4dp"
            android:layout_marginTop="24dp"
            android:padding="0dp"
            android:text="−"
            app:layout_constraintStart_toStartOf="@id/guide_75"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/key_add" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
