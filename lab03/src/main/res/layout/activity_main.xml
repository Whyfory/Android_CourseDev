<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="实验三 · Android 界面组件"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/open_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ListView · 动物和通知"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/open_dialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="自定义登录对话框"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/open_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="XML 菜单"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/open_selection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ActionMode · 长按多选"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/open_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RecyclerView · 动物列表"
            android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
